# Root .dockerignore — applies to all service builds from the monorepo root.

# Frontend: exclude heavy derived artifacts but keep source for the frontend Dockerfile.
# The backend/gateway/etc Dockerfiles never COPY apps/frontend/** so source files
# don't affect those builds — only the frontend Dockerfile needs the source.
apps/frontend/.next
apps/frontend/node_modules
apps/frontend/coverage
apps/frontend/playwright-report
apps/frontend/.env
apps/frontend/.env.*
!apps/frontend/.env.example

# Exclude backend artefacts that should not be in the image
apps/backend/dist
apps/backend/coverage
apps/backend/uploads
apps/backend/backups
apps/backend/test
apps/backend/grafana
apps/backend/.env
apps/backend/.env.*
!apps/backend/.env.example
apps/backend/docker
apps/backend/prisma/seed.ts

# Root-level dev files
.git
.github
*.md
!README.md
.DS_Store

# Node modules (copied from the deps stage, not from host)
node_modules
