{
  "name": "ecommerce-monorepo",
  "version": "1.0.0",
  "description": "E-commerce application monorepo (frontend + backend)",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/notification-service",
    "apps/search-service",
    "apps/auth-service",
    "apps/gateway",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "turbo run start:dev --filter=apps/*",
    "dev:services": "turbo run start:dev --filter=apps/backend --filter=apps/gateway --filter=apps/auth-service --filter=apps/search-service --filter=apps/notification-service",
    "dev:backend": "turbo run start:dev --filter=apps/backend",
    "dev:notification": "turbo run start:dev --filter=apps/notification-service",
    "dev:search": "turbo run start:dev --filter=apps/search-service",
    "dev:auth": "turbo run start:dev --filter=apps/auth-service",
    "dev:gateway": "turbo run start:dev --filter=apps/gateway",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "install:all": "npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/**/*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nestjs/core": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.16"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true
  }
}
