generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // At runtime: routes through PgBouncer (?pgbouncer=true disables prepared statements)
  url       = env("DATABASE_URL")
  // For migrations only: bypasses PgBouncer because `prisma migrate` uses advisory
  // locks which are session-scoped and incompatible with transaction pooling mode.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  VENDOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([emailVerified])
  @@index([role, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

// ── Product ───────────────────────────────────────────────────────────────────
// Parent product: searchable/displayable unit. Price/cost/stock live on
// ProductVariant. The price/cost/stock fields here are kept during the
// expand step of expand-contract migration (see ROADMAP Phase 1).
// They will be removed in a future "contract" migration once all cart/order
// code has been migrated to reference ProductVariant.
model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  // Kept for backward compat (expand step) — move to ProductVariant in contract step
  price       Decimal        @db.Decimal(10, 2)
  cost        Decimal        @db.Decimal(10, 2)
  stock       Int            @default(0)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  variantTypes VariantType[]
  variants    ProductVariant[]
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // searchVector (tsvector GENERATED column) is managed by raw SQL migration — not
  // declared here so Prisma does not try to ORM-manage it. Use prisma.$queryRaw for FTS.

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([price])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ── Variant taxonomy ──────────────────────────────────────────────────────────
// VariantType: "Size", "Color" (belongs to a Product)
// VariantOption: "S", "M", "L" or "Red", "Blue" (belongs to a VariantType)
// ProductVariant: the actual sellable SKU with its own price/cost/stock/images
// VariantAttributeValue: junction mapping variant → options (Size=L, Color=Red)
model VariantType {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String          // e.g. "Size", "Color"
  options   VariantOption[]
  createdAt DateTime        @default(now())

  @@unique([productId, name])
  @@index([productId])
}

model VariantOption {
  id            String                  @id @default(cuid())
  variantTypeId String
  variantType   VariantType             @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)
  value         String                  // e.g. "S", "M", "Red"
  attributeValues VariantAttributeValue[]

  @@unique([variantTypeId, value])
  @@index([variantTypeId])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @unique
  price           Decimal                 @db.Decimal(10, 2)
  cost            Decimal                 @db.Decimal(10, 2)
  stock           Int                     @default(0)
  images          VariantImage[]
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@index([productId, isActive])
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean        @default(false)
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([variantId])
}

// Composite PK: a variant can only have one option per type (e.g. can't be both S and M)
model VariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    VariantOption  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
}

// ── Cart ──────────────────────────────────────────────────────────────────────
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// Expand step: variantId is nullable — existing items continue to reference Product.
// Contract step (future): make variantId required, drop productId + update unique constraint.
model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  totalPrice      Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentIntentId String?       @unique
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ── Reliability (Phase 2) ─────────────────────────────────────────────────────

// Idempotency: stores request key + cached response so retries return the same
// result without re-executing the handler. Applied to POST /orders.
model IdempotencyKey {
  id           String    @id @default(cuid())
  userId       String
  key          String
  statusCode   Int       @default(201)
  // Cached response body — returned verbatim on duplicate requests
  responseBody Json      @default("{}")
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@index([createdAt])
}

// Outbox: events written atomically with the business transaction and processed
// asynchronously. Guarantees at-least-once delivery even if the app crashes
// between the DB write and the queue enqueue.
model OutboxEvent {
  id            String            @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  error         String?
  processedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
  @@index([aggregateId])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int
  price             Decimal  @db.Decimal(10, 2)
  // Snapshot of variant attributes at purchase time (e.g. {Size: "L", Color: "Red"}).
  // Stored as JSON, NOT a FK — variants can be deleted but the order must remember
  // what was purchased. This is the canonical pattern for order line items.
  variantAttributes Json?

  @@index([orderId])
  @@index([productId])
}
