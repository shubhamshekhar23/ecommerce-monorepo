generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // At runtime: routes through PgBouncer (?pgbouncer=true disables prepared statements)
  url       = env("DATABASE_URL")
  // For migrations only: bypasses PgBouncer because `prisma migrate` uses advisory
  // locks which are session-scoped and incompatible with transaction pooling mode.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  VENDOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OAuthProvider {
  GOOGLE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 2FA (TOTP)
  totpSecret    String?
  totpEnabled   Boolean  @default(false)

  refreshTokens       RefreshToken[]
  oauthAccounts       OAuthAccount[]
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  reviews             ProductReview[]
  stockAlerts         StockAlert[]
  passwordResetTokens PasswordResetToken[]
  returnRequests      ReturnRequest[]

  // Partial index (role, createdAt DESC) WHERE isActive = true is managed by raw SQL migration.
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([emailVerified])
  @@index([role, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

// Links a User to a third-party OAuth provider (Google, etc.).
// A user can have multiple providers linked to the same account.
model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// Append-only audit trail. PostgreSQL RULE blocks UPDATE and DELETE at the DB level
// (see migration) so no application bug can tamper with it.
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  userEmail String?
  userRole  String?
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([timestamp])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

// ── Product ───────────────────────────────────────────────────────────────────
// Parent product: searchable/displayable unit. Price/cost/stock live on
// ProductVariant. The price/cost/stock fields here are kept during the
// expand step of expand-contract migration (see ROADMAP Phase 1).
// They will be removed in a future "contract" migration once all cart/order
// code has been migrated to reference ProductVariant.
model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  detail      ProductDetail?
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  variantTypes  VariantType[]
  variants      ProductVariant[]
  reviews       ProductReview[]
  rating        ProductRating?
  stockAlerts   StockAlert[]
  // Nullable until vendor module is built (expand-contract migration).
  // Used by Row-Level Security policy: vendors only see their own products.
  vendorId    String?
  isActive    Boolean        @default(true)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // searchVector (tsvector GENERATED column) is managed by raw SQL migration — not
  // declared here so Prisma does not try to ORM-manage it. Use prisma.$queryRaw for FTS.
  // Partial indexes (categoryId, createdAt) and (createdAt) WHERE isActive = true are
  // managed by raw SQL migration for the same reason.

  @@index([slug])
  @@index([categoryId])
  @@index([vendorId])
  @@index([createdAt])
  @@index([isActive, createdAt])
}

model ProductDetail {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  description String?
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ── Variant taxonomy ──────────────────────────────────────────────────────────
// VariantType: "Size", "Color" (belongs to a Product)
// VariantOption: "S", "M", "L" or "Red", "Blue" (belongs to a VariantType)
// ProductVariant: the actual sellable SKU with its own price/cost/stock/images
// VariantAttributeValue: junction mapping variant → options (Size=L, Color=Red)
model VariantType {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String          // e.g. "Size", "Color"
  options   VariantOption[]
  createdAt DateTime        @default(now())

  @@unique([productId, name])
  @@index([productId])
}

model VariantOption {
  id            String                  @id @default(cuid())
  variantTypeId String
  variantType   VariantType             @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)
  value         String                  // e.g. "S", "M", "Red"
  attributeValues VariantAttributeValue[]

  @@unique([variantTypeId, value])
  @@index([variantTypeId])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @unique
  price           Decimal                 @db.Decimal(10, 2)
  cost            Decimal                 @db.Decimal(10, 2)
  stock           Int                     @default(0)
  images          VariantImage[]
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockAlerts     StockAlert[]
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  // Partial index (productId) WHERE isActive = true is managed by raw SQL migration.
  @@index([productId])
  @@index([sku])
  @@index([productId, isActive])
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean        @default(false)
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([variantId])
}

// Composite PK: a variant can only have one option per type (e.g. can't be both S and M)
model VariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    VariantOption  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
}

// ── Cart ──────────────────────────────────────────────────────────────────────
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// Contract step complete: variantId is required. Unique constraint is now per variant
// (allows two different variants of the same product in the same cart).
model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  returnRequests  ReturnRequest[]
  totalPrice      Decimal       @db.Decimal(10, 2)
  // Snapshot fields — stored at order time, never updated even if rates change later
  subtotal        Decimal?      @db.Decimal(10, 2)
  discountAmount  Decimal?      @db.Decimal(10, 2)
  shippingCost    Decimal?      @db.Decimal(10, 2)
  taxAmount       Decimal?      @db.Decimal(10, 2)
  // Coupon: keep code + id as references (coupon may be deleted, code is human-readable)
  couponId        String?
  couponCode      String?
  // Snapshot of the shipping address at order time — immutable after placement.
  // Stored as JSON (not FK) so the order is preserved even if the user later
  // edits or deletes their address. This is the canonical snapshot pattern.
  shippingAddress Json?
  status          OrderStatus   @default(PENDING)
  paymentIntentId String?       @unique
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ── Reliability (Phase 2) ─────────────────────────────────────────────────────

// Idempotency: stores request key + cached response so retries return the same
// result without re-executing the handler. Applied to POST /orders.
model IdempotencyKey {
  id           String    @id @default(cuid())
  userId       String
  key          String
  statusCode   Int       @default(201)
  // Cached response body — returned verbatim on duplicate requests
  responseBody Json      @default("{}")
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@index([createdAt])
}

// Outbox: events written atomically with the business transaction and processed
// asynchronously. Guarantees at-least-once delivery even if the app crashes
// between the DB write and the queue enqueue.
model OutboxEvent {
  id            String            @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  error         String?
  processedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
  @@index([aggregateId])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int
  price             Decimal         @db.Decimal(10, 2)
  variantAttributes Json?
  categoryName      String?
  returnItems       ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ── Phase 7: Core Feature Backfill ───────────────────────────────────────────

// Snapshot pattern: address is copied to Order.shippingAddress at checkout.
// The Address record can be edited/deleted without affecting past orders.
model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String
  country    String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Coupon: optimistic locking is applied at the DB level (atomic UPDATE with WHERE clause).
// No SELECT-then-UPDATE — that's a TOCTOU race condition. See CouponService for the pattern.
model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)  // percentage (0-100) or fixed amount
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  maxUses        Int?       // null = unlimited
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  usages         CouponUsage[]

  // Partial index (code) WHERE isActive = true is managed by raw SQL migration.
  @@index([code])
}

// One usage record per coupon per order — prevents double-applying on retries.
model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  orderId  String
  userId   String
  usedAt   DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
}

// Product reviews with moderation. Rating is NOT stored on Product directly —
// instead ProductRating is a materialized aggregate updated via events when
// a review is approved. This keeps the Product table narrow and the aggregate
// eventually consistent (acceptable for display, not for stock decisions).
model ProductReview {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int          // 1–5
  title     String?
  body      String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

// Materialized aggregate — recomputed whenever a review is approved or removed.
// One row per product. Query is: SELECT avgRating, reviewCount FROM ProductRating WHERE productId = ?
// instead of: SELECT AVG(rating) FROM ProductReview WHERE productId = ? AND status = 'APPROVED'
model ProductRating {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  avgRating   Decimal @db.Decimal(3, 2)
  reviewCount Int     @default(0)
  updatedAt   DateTime @updatedAt
}

// Fan-out pattern: when a product comes back in stock, one event triggers
// N notification jobs — one per subscribed user.
model StockAlert {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  notified  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([productId, variantId, userId])
  @@index([productId, notified])
  @@index([variantId, notified])
}

// Secure token pattern: HMAC-signed, single-use, short TTL.
// The token value stored here is a hash — the raw token is emailed and never persisted.
// On reset: hash(receivedToken) == storedToken? → proceed and mark usedAt.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique  // SHA-256(rawToken) — raw token is only in the email link
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Return/refund workflow — state machine with compensating transactions.
// ReturnRequest is created by the user, approved/rejected by admin,
// then the Stripe refund is issued (compensating the original charge).
model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  reason    String
  status    ReturnStatus @default(PENDING)
  items     ReturnItem[]
  refundId  String?      // Stripe refund ID once issued
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  reason          String?

  @@index([returnRequestId])
}

// ── Phase 10: Advanced Database ──────────────────────────────────────────────

// RequestMetric: HTTP request timing data, stored in a range-partitioned table.
//
// Why a composite @@id([id, timestamp])?
//   PostgreSQL requires the partition key to be part of any unique constraint.
//   Since we partition by RANGE(timestamp), timestamp must be in the PK.
//   The migration creates the table as PARTITION BY RANGE ("timestamp") —
//   Prisma itself creates a regular table but the migration overrides this.
//
// Usage: findFirst({ where: { id } }) works via the index.
// For true PK lookup: findFirst({ where: { id, timestamp } }).
// StripeWebhookEvent: deduplication log for Stripe webhook events.
// Stripe retries delivery for up to 72 hours — the same event ID can arrive multiple times.
// Inserting the event ID with a unique constraint and using ON CONFLICT DO NOTHING
// is the atomic check-and-insert that prevents double-processing.
model StripeWebhookEvent {
  id          String   @id                // Stripe event ID, e.g. evt_xxx
  type        String                      // e.g. payment_intent.succeeded
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model RequestMetric {
  id         BigInt   @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  method     String   @db.Text
  path       String   @db.Text
  statusCode Int
  durationMs Int
  userId     String?  @db.Text

  @@id([id, timestamp])
  @@index([timestamp])
  @@index([path, statusCode])
  @@index([userId])
}
