{
  "name": "ecommerce-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit",
    "ci": "npm run lint:check && npm run format:check && npm run type-check && npm run test -- --passWithNoTests --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:extensive": "DIRECT_DATABASE_URL=postgresql://ecommerce_user:ecommerce_password@localhost:5434/ecommerce_db ts-node prisma/seed.extensive.ts",
    "prisma:studio": "prisma studio",
    "load:setup": "ts-node test/load/scripts/setup-test-data.ts",
    "load:clean": "ts-node test/load/scripts/cleanup-test-data.ts",
    "load:single": "artillery run test/load/scenarios/00-single-api.yml",
    "load:single:report": "artillery run --output single-api-report.json test/load/scenarios/00-single-api.yml && artillery report single-api-report.json --output single-api-report.html",
    "load:guest": "artillery run test/load/scenarios/01-guest-browse.yml",
    "load:auth": "artillery run test/load/scenarios/02-user-auth.yml",
    "load:cart": "artillery run test/load/scenarios/03-shopping-cart.yml",
    "load:checkout": "artillery run test/load/scenarios/04-checkout.yml",
    "load:orders": "artillery run test/load/scenarios/05-order-management.yml",
    "load:mixed": "artillery run test/load/scenarios/06-mixed-traffic.yml",
    "load:all": "npm run load:guest && npm run load:auth && npm run load:cart && npm run load:checkout && npm run load:orders",
    "load:report": "artillery run --output report.json test/load/scenarios/06-mixed-traffic.yml && artillery report report.json --output report.html",
    "load:scenario-01": "artillery run load-tests/scenarios/scenario-01-high-500-error-rate.yml",
    "load:scenario-02": "artillery run load-tests/scenarios/scenario-02-slow-postgres-query.yml",
    "load:scenario-03": "artillery run load-tests/scenarios/scenario-03-connection-pool-exhaustion.yml",
    "load:scenario-04": "artillery run load-tests/scenarios/scenario-04-redis-cache-not-working.yml",
    "load:scenario-05": "artillery run load-tests/scenarios/scenario-05-cpu-spike.yml",
    "load:scenario-06": "artillery run load-tests/scenarios/scenario-06-n-plus-one-query.yml",
    "load:scenario-07": "artillery run load-tests/scenarios/scenario-07-external-api-slow.yml",
    "load:scenario-08": "artillery run load-tests/scenarios/scenario-08-memory-leak.yml",
    "load:scenario-09": "artillery run load-tests/scenarios/scenario-09-per-user-failure.yml",
    "load:scenario-10": "artillery run load-tests/scenarios/scenario-10-postgres-locks.yml",
    "load:scenario-11": "artillery run load-tests/scenarios/scenario-11-random-timeout-high-p99.yml",
    "load:scenario-12": "artillery run load-tests/scenarios/scenario-12-background-job-failure.yml",
    "load:scenario-13": "artillery run load-tests/scenarios/scenario-13-payment-failures.yml",
    "load:scenario-14": "artillery run load-tests/scenarios/scenario-14-queue-backlog.yml",
    "load:scenario-15": "artillery run load-tests/scenarios/scenario-15-missing-index.yml",
    "load:scenario-16": "artillery run load-tests/scenarios/scenario-16-excessive-retries.yml",
    "load:scenario-17": "artillery run load-tests/scenarios/scenario-17-cache-stampede.yml",
    "load:scenario-18": "artillery run load-tests/scenarios/scenario-18-deadlock.yml",
    "load:scenario-19": "artillery run load-tests/scenarios/scenario-19-high-4xx-error-rate.yml",
    "load:scenario-20": "artillery run load-tests/scenarios/scenario-20-connection-leak.yml",
    "load:scenario-21": "artillery run load-tests/scenarios/scenario-21-silent-transaction-failure.yml"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@ecommerce/shared-types": "*",
    "@golevelup/nestjs-rabbitmq": "^8.1.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/terminus": "^10.0.0",
    "@nestjs/websockets": "^11.1.27",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.58.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.77.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "csv-parse": "^6.2.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "nestjs-pino": "^3.5.0",
    "nodemailer": "^8.0.0",
    "opossum": "^9.0.0",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pino": "^8.17.0",
    "pino-http": "^8.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.0",
    "@eslint/js": "^8.56.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.9",
    "@types/opossum": "^8.1.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "artillery": "^2.0.21",
    "artillery-plugin-expect": "^2.24.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    }
  }
}
