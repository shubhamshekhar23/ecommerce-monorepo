{
  "$schema": "https://stryker-mutator.io/schemas/stryker-schema.json#",
  "testRunner": "jest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/modules/orders/**/*.ts",
    "src/modules/products/**/*.ts",
    "!src/modules/orders/**/*.spec.ts",
    "!src/modules/products/**/*.spec.ts",
    "!src/modules/orders/**/*.dto.ts",
    "!src/modules/products/**/*.dto.ts",
    "!src/modules/orders/**/*.module.ts",
    "!src/modules/products/**/*.module.ts"
  ],
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "enableFindRelatedTests": true
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": false
}
